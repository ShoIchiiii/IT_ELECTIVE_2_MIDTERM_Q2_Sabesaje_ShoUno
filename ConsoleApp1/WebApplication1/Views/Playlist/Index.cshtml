@model List<WebApplication1.Models.Entities.Playlist>

@{
    ViewData["Title"] = "Playlists";
}

<div class="container py-4">
    <!-- Top Header Banner -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center bg-white p-4 rounded-4 shadow-sm mb-4 border">
        <div>
            <h2 class="fw-bold mb-1 text-dark">🎵 YouTube Playlists</h2>
            <p class="text-muted mb-0">
                Logged in as: <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill fs-6">@ViewBag.Username</span>
            </p>
        </div>
        <div class="mt-3 mt-md-0 d-flex gap-2">
            <a asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow-sm fw-semibold">
                + Create New Playlist
            </a>
            <a asp-controller="Auth" asp-action="Logout" class="btn btn-outline-danger rounded-pill px-3">
                Logout
            </a>
        </div>
    </div>

    <!-- Playlist Cards Grid -->
    @if (!Model.Any())
    {
        <div class="text-center py-5 bg-white rounded-4 border shadow-sm">
            <div class="fs-1 text-muted mb-3">📂</div>
            <h4 class="fw-bold text-secondary">No Playlists Found</h4>
            <p class="text-muted">Start by creating your very first server-rendered playlist!</p>
            <a asp-action="Create" class="btn btn-primary rounded-pill px-4 mt-2">
                Create Playlist
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var playlist in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden position-relative">
                        <!-- Card Header -->
                        <div class="bg-gradient bg-dark text-white p-4">
                            <span class="badge bg-danger rounded-pill px-3 py-1 small mb-2">Playlist</span>
                            <h4 class="card-title fw-bold text-truncate mb-1" title="@playlist.Title">@playlist.Title</h4>
                            <small class="text-white-50">By @playlist.CreatorName</small>
                        </div>

                        <!-- Card Body / Track List -->
                        <div class="card-body p-4 bg-white d-flex flex-column justify-content-between">
                            <div>
                                <h6 class="fw-bold text-muted mb-3 small text-uppercase tracking-wider">
                                    Tracks (@playlist.Videos.Count)
                                </h6>
                                <div class="list-group list-group-flush">
                                    @foreach (var video in playlist.Videos)
                                    {
                                        <div class="list-group-item px-0 py-2 border-0 bg-transparent">
                                            <div class="d-flex align-items-start">
                                                <span class="text-danger me-2 fs-5">▶</span>
                                                <div class="text-truncate">
                                                    <a href="@video.YouTubeUrl" target="_blank" class="fw-semibold text-dark text-decoration-none">
                                                        @(string.IsNullOrWhiteSpace(video.TrackNote) ? "YouTube Link" : video.TrackNote)
                                                    </a>
                                                    <br />
                                                    <small class="text-muted text-truncate d-block" style="max-width: 220px;">
                                                        @video.YouTubeUrl
                                                    </small>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
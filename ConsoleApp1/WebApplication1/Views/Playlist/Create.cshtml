@model WebApplication1.Models.DTOs.CreatePlaylistDto

@{
    ViewData["Title"] = "Create Playlist";
}

<div class="container py-4" style="max-width: 720px;">
    <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
        <!-- Form Header -->
        <div class="bg-gradient bg-primary text-white p-4 d-flex justify-content-between align-items-center">
            <div>
                <h3 class="fw-bold mb-0">Create New Playlist</h3>
                <small class="text-white-50">Server-rendered dynamic form (Zero JavaScript)</small>
            </div>
            <a asp-action="Index" class="btn btn-outline-light btn-sm rounded-pill px-3">
                Cancel
            </a>
        </div>

        <!-- Form Body -->
        <div class="card-body p-4 p-md-5 bg-white">
            <form method="post">
                <!-- Title Field -->
                <div class="mb-4">
                    <label asp-for="Title" class="form-label fw-bold">Playlist Title</label>
                    <input asp-for="Title" class="form-control form-control-lg rounded-3 fs-6" placeholder="e.g., OPM Acoustic Jam" />
                    <span asp-validation-for="Title" class="text-danger small mt-1 d-block"></span>
                </div>

                <hr class="my-4 text-muted opacity-25" />

                <!-- Dynamic Track List -->
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0">Track List</h5>
                    <span class="badge bg-secondary rounded-pill">@Model.Videos.Count Tracks</span>
                </div>

                @for (int i = 0; i < Model.Videos.Count; i++)
                {
                    <div class="card border border-light-subtle shadow-sm rounded-3 mb-3 bg-light">
                        <div class="card-body p-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="badge bg-dark rounded-pill">Track #@(i + 1)</span>
                                @if (Model.Videos.Count > 1)
                                {
                                    <button type="submit"
                                            asp-action="RemoveVideoRow"
                                            asp-route-index="@i"
                                            formnovalidate
                                            class="btn btn-outline-danger btn-sm rounded-pill px-3">
                                        Remove
                                    </button>
                                }
                            </div>

                            <div class="mb-2">
                                <input name="Videos[@i].YouTubeUrl"
                                       value="@Model.Videos[i].YouTubeUrl"
                                       class="form-control rounded-2"
                                       placeholder="Paste YouTube Link (e.g. https://youtu.be/...)" />
                            </div>
                            <div>
                                <input name="Videos[@i].TrackNote"
                                       class="form-control rounded-2"
                                       value="@Model.Videos[i].TrackNote"
                                       placeholder="Track Note / Song Title (e.g. Eraserheads Cover)" />
                            </div>
                        </div>
                    </div>
                }

                <!-- Add Row Button -->
                <div class="mb-4">
                    <button type="submit" asp-action="AddVideoRow" formnovalidate class="btn btn-outline-primary w-100 rounded-3 py-2 fw-semibold">
                        + Add Another Track
                    </button>
                </div>

                <hr class="my-4 text-muted opacity-25" />

                <!-- Submit Button -->
                <div class="d-grid">
                    <button type="submit" asp-action="Save" class="btn btn-success btn-lg rounded-pill shadow-sm fw-bold">
                        💾 Save Complete Playlist
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>